{
  "name": "@mandulaj/pagefind-search",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "pagefind-search",
    "displayName": "Pagefind Search",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "PagefindSearch": {
        "displayName": "Pagefind Search",
        "defaultPosition": "left",
        "defaultPriority": 20
      }
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
