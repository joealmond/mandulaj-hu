# Cloudflare defaults to public, max-age=0, must-revalidate. Keep that for
# HTML, attachments, Pagefind and other files whose URLs are stable.
# postbuild appends exact immutable rules only for content-hashed assets.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/index.xml
  Content-Type: application/rss+xml; charset=utf-8
