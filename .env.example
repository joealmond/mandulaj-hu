# Copy to `.env` and fill in. Every value here is OPTIONAL —
# the build succeeds with all of them unset, features just stay off.

# ── Umami (privacy-friendly, cookieless analytics) ───────────────────────
# Point at your own Hetzner instance. Include the protocol.
# Unset -> no analytics script is emitted at all.
UMAMI_HOST=
UMAMI_WEBSITE_ID=

# ── Webmentions (webmention.io) ──────────────────────────────────────────
# Domain token from https://webmention.io/settings — used to READ mentions
# at build time. Unset -> the mentions section renders nothing.
WEBMENTION_IO_TOKEN=
# Domain registered with webmention.io, e.g. mandulaj.hu
WEBMENTION_DOMAIN=

# ── Turnstile (spam protection on comments) ─────────────────────────────
# The SITE key is public and is baked into the HTML at build time.
# The SECRET key is NOT here — set it with `wrangler secret put TURNSTILE_SECRET_KEY`.
# Unset -> the comment form is hidden and the page says comments are off.
TURNSTILE_SITE_KEY=

# ── Vault location ───────────────────────────────────────────────────────
# Only needed if your vault is not at the path in scripts/publish.config.ts
VAULT_PATH=
