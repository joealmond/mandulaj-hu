# Copy to .dev.vars for local Worker development. Never commit real values.
VISITOR_SALT=replace-with-at-least-32-random-bytes
# Cloudflare's documented test secrets, for local development:
#   1x0000000000000000000000000000000AA  always PASSES (use this normally)
#   2x0000000000000000000000000000000AA  always FAILS  (to exercise rejection)
# The always-pass key returns success for ANY token, including garbage, and
# reports hostname "example.com" with no action — so the hostname and action
# checks cannot be exercised locally. The unit tests cover those with stubbed
# responses instead.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TELEGRAM_BOT_TOKEN=optional
TELEGRAM_CHAT_ID=optional
